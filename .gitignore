# Original high-resolution images (do not commit to Git)
/img/*
!/img/.gitkeep

# Temporary download and processing files
*.part
*.tmp

# Python cache and build artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables
.env
.env.*

# IDE and editor directories
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db